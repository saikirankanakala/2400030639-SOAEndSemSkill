{
  "info": {
    "name": "Tourist Update API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test('Token received', () => pm.expect(json.token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. GET tourist by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/tourists/1", "host": ["{{baseUrl}}"], "path": ["api", "tourists", "1"] }
      }
    },
    {
      "name": "3. PUT update tourist (valid token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eql('Ravi Kumar Updated'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ravi Kumar Updated\",\n  \"email\": \"ravi.updated@example.com\",\n  \"phone\": \"9999999999\",\n  \"country\": \"India\",\n  \"passportNumber\": \"P7654321\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/tourists/1", "host": ["{{baseUrl}}"], "path": ["api", "tourists", "1"] }
      }
    },
    {
      "name": "4. PUT without token (expect 401)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"h@example.com\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/tourists/1", "host": ["{{baseUrl}}"], "path": ["api", "tourists", "1"] }
      }
    },
    {
      "name": "5. PUT with invalid token (expect 401)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer invalid.token.value" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"h@example.com\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/tourists/1", "host": ["{{baseUrl}}"], "path": ["api", "tourists", "1"] }
      }
    }
  ]
}
